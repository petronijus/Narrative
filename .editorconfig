# Matches .prettierrc (which formats on commit and after every agent edit).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[justfile]
indent_size = 4

[*.sql]
max_line_length = off
