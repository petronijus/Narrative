# Narrative — environment variables template
# Copy to .env and fill in values. Never commit .env to git.

# ─── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_DB=narrative
POSTGRES_USER=narrative
POSTGRES_PASSWORD=changeme_use_a_strong_password
POSTGRES_PORT=5432
# Poznámka: pokud máš nativní Postgres na 5432 (běžné na Windows), použij 5433
# a v POSTGRES_URL níže změň localhost → 127.0.0.1 (kvůli IPv6 resolution collision).

# ─── Server (apps/server) ─────────────────────────────────────────────────────
API_PORT=3001
HOCUSPOCUS_PORT=3002
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Postgres connection string pro server + drizzle-kit
POSTGRES_URL=postgres://narrative:changeme_use_a_strong_password@127.0.0.1:5432/narrative

# ─── Web (apps/web — Vite env vars, prefix VITE_) ─────────────────────────────
VITE_HOCUSPOCUS_URL=ws://localhost:3002
VITE_API_URL=http://localhost:3001

# ─── CORS (server) ────────────────────────────────────────────────────────────
# CORS_ORIGIN=http://localhost:5173  # default pro dev

# ─── Production (docker compose prod) ─────────────────────────────────────────
# DOMAIN=narrative.example.com       # Caddy auto-TLS doména
# PG_DATA_PATH=/mnt/tank/narrative/postgres  # ZFS dataset path pro Postgres
# ZFS_DATASET=tank/narrative         # Pro deploy.sh ZFS snapshot
# BACKUP_DIR=/mnt/tank/narrative/backups

# ─── Future: added in later milestones ────────────────────────────────────────
# AUTHENTIK_SECRET_KEY=              # M10 — OIDC auth
# MINIO_ROOT_USER=                   # M11 — object storage
# MINIO_ROOT_PASSWORD=               # M11
# SENTRY_DSN=                        # M6 — error tracking
# ANTHROPIC_API_KEY=                 # M16 — AI slide generation
