# Narrative — environment variables template
# Copy to .env and fill in values. Never commit .env to git.

# ─── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_DB=narrative
POSTGRES_USER=narrative
POSTGRES_PASSWORD=changeme_use_a_strong_password
POSTGRES_PORT=5432
# Note: if you have a native Postgres on 5432 (common on Windows), use 5433
# and in POSTGRES_URL below change localhost → 127.0.0.1 (IPv6 resolution fix).

# ─── Server (apps/server) ─────────────────────────────────────────────────────
API_PORT=3001
HOCUSPOCUS_PORT=3002
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Postgres connection string for server + drizzle-kit
POSTGRES_URL=postgres://narrative:changeme_use_a_strong_password@127.0.0.1:5432/narrative

# ─── Web (apps/web — Vite env vars, VITE_ prefix) ─────────────────────────────
VITE_HOCUSPOCUS_URL=ws://localhost:3002
VITE_API_URL=http://localhost:3001

# ─── CORS (server) ────────────────────────────────────────────────────────────
# CORS_ORIGIN=http://localhost:5173  # default for dev; comma-separated for multiple, e.g. https://app.example.com,https://staging.example.com

# ─── Video worker ─────────────────────────────────────────────────────────────
# FFMPEG_THREADS=2                # Per-ffmpeg-process thread cap. Default: 2.
# TRANSCODE_TMP_DIR=/tmp/narrative-transcode  # Override for hosts with small /tmp tmpfs.

# ─── Production (docker compose prod) ─────────────────────────────────────────
# DOMAIN=narrative.example.com       # Caddy auto-TLS domain
# PG_DATA_PATH=/mnt/tank/narrative/postgres  # ZFS dataset path for Postgres
# ZFS_DATASET=tank/narrative         # For deploy.sh ZFS snapshot
# BACKUP_DIR=/mnt/tank/narrative/backups

# ─── OIDC (Google) — server-driven session cookie flow ───────────────────────
# Identity is provided by Google OIDC. The server runs the OAuth dance
# entirely (since 2026-05); the SPA never sees the id_token. Sessions live
# as opaque rows in the `sessions` table and are referenced from the browser
# via an HttpOnly `narrative_session` cookie.
#
# Setup:
#   1. https://console.cloud.google.com → APIs & Services → Credentials
#   2. Create OAuth 2.0 Client ID → Web application
#   3. Authorized redirect URIs (note the /api/ prefix in prod — Caddy
#      strips it before forwarding to the server):
#      - http://localhost:3001/auth/callback         (dev)
#      - https://YOUR_DOMAIN/api/auth/callback       (prod)
#   4. Copy the client_id and client_secret into OIDC_CLIENT_ID +
#      OIDC_CLIENT_SECRET below.
OIDC_ISSUER=https://accounts.google.com
OIDC_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
OIDC_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
OIDC_CLIENT_SECRET=
# Optional explicit override; default in dev is http://localhost:3001/auth/callback
# OIDC_REDIRECT_URI=http://localhost:3001/auth/callback

# Allowlist — at least one SHOULD be set, otherwise ANY Google account can sign in.
# Comma-separated exact emails:
# OIDC_ALLOWED_EMAILS=alice@example.com,bob@example.com
# Or an entire workspace domain (allows accounts whose email_verified=true ends in @domain):
# OIDC_ALLOWED_DOMAIN=example.com

# 64-byte hex random — signs the short-lived OAuth state cookie. REQUIRED in prod.
# Generate: openssl rand -hex 32
SESSION_COOKIE_SECRET=

# Where the SPA lives (used as the post-login redirect target). Defaults to
# http://localhost:5173 in dev, https://${DOMAIN} in prod.
# SPA_ORIGIN=http://localhost:5173

# Dev-only auth bypass — set to true to skip OAuth + session lookup entirely
# (synthesises dev-user for every request). A loud warning logs on start.
# NEVER set in production.
BYPASS_AUTH=false
# Same for the SPA — synthesises dev-user without calling /auth/me.
VITE_BYPASS_AUTH=false

# Public base URL — used to construct share link URLs returned by POST /decks/:id/share-links.
# In production: set to your public domain, e.g. https://narrative.example.com
# In dev: leave empty or set to http://localhost:5173 (Vite frontend)
# PUBLIC_URL=http://localhost:5173

# ─── MCP server + OAuth for agents (docs/mcp.md) ──────────────────────────────
# Public base URL of the API. The MCP endpoint is <base>/mcp — exactly the URL
# Claude Code / claude.ai are given — and every MCP OAuth token is bound to it,
# so it must match what clients call. Defaults: dev http://localhost:${API_PORT};
# prod <SPA_ORIGIN>/api, i.e. https://DOMAIN/api (compose passes it explicitly).
# PUBLIC_API_URL=http://localhost:3001
# Extra OAuth redirect URIs a client may use, comma-separated, besides the
# built-in https://claude.ai/api/mcp/auth_callback and Claude Code's loopback
# http://localhost/callback + http://127.0.0.1/callback (any port). https URLs
# match exactly; http URLs are allowed on localhost / 127.0.0.1 only and match
# on any port. Usually empty.
# MCP_OAUTH_REDIRECT_URIS=
# Hosts whose OAuth Client ID Metadata Documents are accepted, comma-separated
# (`none` = none). Default claude.ai, which serves Claude Code's document.
# MCP_OAUTH_CIMD_HOSTS=claude.ai
# OAuth dynamic client registration (RFC 7591). Off by default; Claude Code and
# claude.ai use metadata documents.
# MCP_OAUTH_DCR_ENABLED=false
# Hostnames agent URL downloads may reach without the user confirming the host
# (comma-separated, exact, no port). Empty: every URL download is confirmed.
# AGENT_URL_FETCH_ALLOWED_HOSTS=
# HMAC key of the agent-peer principal keys (>= 32 chars). Required in
# production; dev/test fall back to a built-in dev-only key.
# AGENT_PRINCIPAL_KEY_SECRET=
# Header carrying the real client IP behind the proxy chain, for anonymous
# rate-limit buckets (and /mcp callers without a verified credential). Prod
# compose sets cf-connecting-ip; unset in dev → the socket address.
# CLIENT_IP_HEADER=

# ─── Transactional email (Resend) — for deck invites ──────────────────────────
# When unset, the server logs the would-be email to the console instead of
# sending. Safe for dev + first-prod-boot while DNS verification is pending.
#
# Setup:
#   1. https://resend.com → sign up, free tier = 100/day, 3k/mo.
#   2. Add an API key in the Resend dashboard, paste below.
#   3. To send from your own domain (recommended for deliverability), verify
#      the domain in Resend (adds SPF + DKIM TXT records to DNS) then set
#      EMAIL_FROM=`Narrative <noreply@yourdomain.com>`.
#   4. Without a verified domain, you can only send to the email of your
#      Resend account owner — fine for smoke testing.
# RESEND_API_KEY=re_...
# Default: Narrative <onboarding@resend.dev>  (Resend's shared sender)
# IMPORTANT: quote the value — angle brackets are bash redirection
# operators when the deploy script `source`s this file.
# EMAIL_FROM="Narrative <noreply@yourdomain.com>"

# ─── Observability (optional — silent without DSN) ────────────────────────────
# Sentry: if empty, Sentry is not initialized (dev-friendly)
VITE_SENTRY_DSN=
SENTRY_DSN=

# Build version for Sentry release tracking (set to git sha in CI)
# VITE_BUILD_VERSION=

# ─── MinIO object storage (M11) ──────────────────────────────────────────────
MINIO_ROOT_USER=narrative-admin
MINIO_ROOT_PASSWORD=changeme_strong_password_min_8_chars
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
MEDIA_BUCKET=narrative-media

# ─── imgproxy (M11) ──────────────────────────────────────────────────────────
# Generate KEY and SALT with: xxd -g 2 -l 32 -p /dev/random | tr -d '\n'
# Both must be 64 hex characters (32 bytes). Keep these secret — they protect
# signed imgproxy URLs from manipulation.
IMGPROXY_KEY=changeme_64_hex_chars
IMGPROXY_SALT=changeme_64_hex_chars
IMGPROXY_PORT=8080

# AVIF output tuning. The editor serves AVIF by default (smaller than WebP
# at equal quality; current-Chrome target). AVIF_SPEED 0=slowest/smallest …
# 9=fastest; 8 keeps encode cheap on a modest CPU. FORMAT_QUALITY pins AVIF
# quality (~63 ≈ WebP 80). Raise quality for sharper images at larger files.
IMGPROXY_AVIF_SPEED=8
IMGPROXY_FORMAT_QUALITY=avif=63
# Max source megapixels imgproxy will decode (guards against decompression
# bombs). 50 MP covers any realistic deck image.
IMGPROXY_MAX_SRC_RESOLUTION=50

# imgproxy result cache (nginx sidecar). Open-source imgproxy has no result
# cache, so the imgproxy-cache service caches encoded variants on disk —
# each (asset, variant, format) encodes once instead of per request. Caddy
# routes /imgproxy/* through this in prod. Host port for debugging only.
IMGPROXY_CACHE_PORT=8088

# ─── Server: how to reach MinIO + imgproxy ───────────────────────────────────
# From apps/server, MinIO is reached via the internal Docker hostname in prod,
# or via the published port on localhost in dev (server running natively).
MINIO_ENDPOINT=http://127.0.0.1:9100
# MEDIA-1: browser-facing base for presigned media URLs (private bucket).
# The server signs short-TTL presigned URLs for video playback + font bytes.
#   - dev:  /storage  → informational only. Vite's /storage proxy rewrites the
#           Host (changeOrigin), so presigned URLs are signed against and served
#           directly from MINIO_ENDPOINT (127.0.0.1:9100); the SigV4 Host then
#           matches what MinIO receives.
#   - prod: https://<DOMAIN>/storage → ABSOLUTE. The presigner signs against
#           this public host (matching what Caddy forwards) and prepends
#           /storage for routing; Caddy strips it before MinIO. MUST NOT be the
#           internal MINIO_ENDPOINT or the SigV4 signature is invalid.
# Optional TTL overrides (seconds): MEDIA_VIDEO_URL_TTL_SEC (default 21600 = 6h),
# MEDIA_FONT_URL_TTL_SEC (default 3600 = 1h).
MINIO_PUBLIC_URL=/storage
# IMGPROXY_ENDPOINT is the BASE used when the server signs imgproxy URLs that
# the browser will follow. In dev we route it through Vite's `/imgproxy` proxy
# so the requests are same-origin with `localhost:5173` — imgproxy v3.27 does
# not honour `IMGPROXY_CORS_ALLOW_ORIGIN`, so cross-origin Pixi loads (which
# use `crossorigin="anonymous"`) get blocked otherwise. Vite's proxy adds the
# `Access-Control-Allow-Origin` header automatically. In prod, Caddy fronts
# imgproxy and the public URL is `https://<DOMAIN>/imgproxy`.
IMGPROXY_ENDPOINT=http://localhost:5173/imgproxy

# ─── Web (apps/web) ──────────────────────────────────────────────────────────
# Public imgproxy base URL — browser builds signed URLs against this.
# In prod, traffic routes via Caddy (/imgproxy/* → imgproxy:8080).
# In dev, imgproxy is accessed directly on localhost.
VITE_IMGPROXY_URL=http://localhost:8080

# ─── Video pipeline (M12) ────────────────────────────────────────────────────
# Media queue Redis runs on 6380 to avoid colliding with any generic Redis on 6379.
MEDIA_REDIS_PORT=6380

# Used by apps/server to enqueue BullMQ jobs (server running natively in dev).
# Inside Docker the worker reads REDIS_URL=redis://media-redis:6379 from compose env.
MEDIA_REDIS_URL=redis://127.0.0.1:6380

# Number of parallel ffmpeg transcodes the video-worker runs.
# Keep at 1–2 on machines with limited CPU; increase in M29 after profiling.
WORKER_CONCURRENCY=2

# ─── Future: added in later milestones ────────────────────────────────────────
# ANTHROPIC_API_KEY=                 # M16 — AI slide generation
