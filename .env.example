# Narrative — environment variables template
# Copy to .env and fill in values. Never commit .env to git.

# ─── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_DB=narrative
POSTGRES_USER=narrative
POSTGRES_PASSWORD=changeme_use_a_strong_password
POSTGRES_PORT=5432
# Note: if you have a native Postgres on 5432 (common on Windows), use 5433
# and in POSTGRES_URL below change localhost → 127.0.0.1 (IPv6 resolution fix).

# ─── Server (apps/server) ─────────────────────────────────────────────────────
API_PORT=3001
HOCUSPOCUS_PORT=3002
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Postgres connection string for server + drizzle-kit
POSTGRES_URL=postgres://narrative:changeme_use_a_strong_password@127.0.0.1:5432/narrative

# ─── Web (apps/web — Vite env vars, VITE_ prefix) ─────────────────────────────
VITE_HOCUSPOCUS_URL=ws://localhost:3002
VITE_API_URL=http://localhost:3001

# ─── CORS (server) ────────────────────────────────────────────────────────────
# CORS_ORIGIN=http://localhost:5173  # default for dev

# ─── Production (docker compose prod) ─────────────────────────────────────────
# DOMAIN=narrative.example.com       # Caddy auto-TLS domain
# PG_DATA_PATH=/mnt/tank/narrative/postgres  # ZFS dataset path for Postgres
# ZFS_DATASET=tank/narrative         # For deploy.sh ZFS snapshot
# BACKUP_DIR=/mnt/tank/narrative/backups

# ─── Authentik OIDC (M10) ─────────────────────────────────────────────────────
# Generate AUTHENTIK_SECRET_KEY with: openssl rand -hex 32
AUTHENTIK_POSTGRES_PASSWORD=changeme_authentik_pg
AUTHENTIK_SECRET_KEY=changeme_generate_with_openssl_rand_hex_32
AUTHENTIK_BOOTSTRAP_EMAIL=admin@narrative.local
AUTHENTIK_BOOTSTRAP_PASSWORD=changeme_admin_password
AUTHENTIK_HTTP_PORT=9000

# Server: OIDC validation config (used by apps/server JWT middleware in M10 phase 2)
AUTHENTIK_ISSUER=http://localhost:9000/application/o/narrative/
AUTHENTIK_JWKS_URL=http://localhost:9000/application/o/narrative/jwks/
AUTHENTIK_CLIENT_ID=narrative-web

# Dev-only auth bypass — set to true to skip OIDC JWT validation (synthesizes dev-user).
# When true, all requests run as 'dev-user' regardless of Authorization header.
# A loud warning is logged on server start when this is enabled.
# NEVER set this to true in production.
BYPASS_AUTH=false

# Public base URL — used to construct share link URLs returned by POST /decks/:id/share-links.
# In production: set to your public domain, e.g. https://narrative.example.com
# In dev: leave empty or set to http://localhost:5173 (Vite frontend)
# PUBLIC_URL=http://localhost:5173

# Web: OIDC client config (VITE_ prefix — bundled into frontend in M10 phase 3)
VITE_AUTHENTIK_ISSUER=http://localhost:9000/application/o/narrative/
VITE_AUTHENTIK_CLIENT_ID=narrative-web
VITE_AUTHENTIK_REDIRECT_URI=http://localhost:5173/auth/callback

# ─── Observability (optional — silent without DSN) ────────────────────────────
# Sentry: if empty, Sentry is not initialized (dev-friendly)
VITE_SENTRY_DSN=
SENTRY_DSN=

# Build version for Sentry release tracking (set to git sha in CI)
# VITE_BUILD_VERSION=

# ─── MinIO object storage (M11) ──────────────────────────────────────────────
MINIO_ROOT_USER=narrative-admin
MINIO_ROOT_PASSWORD=changeme_strong_password_min_8_chars
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
MEDIA_BUCKET=narrative-media

# ─── imgproxy (M11) ──────────────────────────────────────────────────────────
# Generate KEY and SALT with: xxd -g 2 -l 32 -p /dev/random | tr -d '\n'
# Both must be 64 hex characters (32 bytes). Keep these secret — they protect
# signed imgproxy URLs from manipulation.
IMGPROXY_KEY=changeme_64_hex_chars
IMGPROXY_SALT=changeme_64_hex_chars
IMGPROXY_PORT=8080

# ─── Server: how to reach MinIO + imgproxy ───────────────────────────────────
# From apps/server, MinIO is reached via the internal Docker hostname in prod,
# or via the published port on localhost in dev (server running natively).
MINIO_ENDPOINT=http://127.0.0.1:9100
IMGPROXY_ENDPOINT=http://127.0.0.1:8080

# ─── Web (apps/web) ──────────────────────────────────────────────────────────
# Public imgproxy base URL — browser builds signed URLs against this.
# In prod, traffic routes via Caddy (/imgproxy/* → imgproxy:8080).
# In dev, imgproxy is accessed directly on localhost.
VITE_IMGPROXY_URL=http://localhost:8080

# ─── Future: added in later milestones ────────────────────────────────────────
# ANTHROPIC_API_KEY=                 # M16 — AI slide generation
