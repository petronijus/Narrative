# Dependencies
node_modules/

# Build outputs
dist/
# Perf harness builds (just perf --mode prod|profiling)
dist-perf-*/
build/
*.tsbuildinfo

# Logs
*.log
logs/

# Spikes — throwaway validation projects
spikes/

# Environment secrets
.env
.env.local
.env.*.local
infra/.env.prod

# Backups
backups/

# Claude local settings, personal hook overrides
.claude/settings.local.json
CLAUDE.local.md
lefthook-local.yml

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# pnpm
.pnpm-store/

# Vite
apps/web/.vite/

# Desktop app packages (electron-builder output, apps/desktop)
apps/desktop/release/

# Playwright E2E artifacts (never commit)
apps/web/test-results/
apps/web/playwright-report/
apps/web/.playwright/

# Stryker mutation-testing reports — regenerated locally
**/reports/mutation/
.stryker-tmp/

# Lighthouse CI artifacts (uploaded to temporary-public-storage)
.lighthouseci/
test-results/
apps/test-results/

# Load-test baselines — local, per machine (see tests/load/README.md → Baselines)
tests/load/baselines.json

# PPTX fixtures — local, developer-supplied (see tests/fixtures/pptx/README.md)
tests/fixtures/pptx/*.pptx

# Private overlay (clone of github.com/petronijus/Narrative-private)
/private/
