<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  What the hardened runtime grants the Narrative desktop app: only JIT, which
  V8 needs. No camera, microphone, unsigned memory or library validation
  exception (ADR 0014; docs/plans/desktop-d0-spec.md §3.12).
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
