{
  "name": "@narrative/render-worker",
  "version": "0.12.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env ../../node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@narrative/shared": "workspace:*",
    "bullmq": "^5.76.11",
    "ioredis": "^5.6.1",
    "playwright-core": "1.60.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/ws": "^8.18.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
