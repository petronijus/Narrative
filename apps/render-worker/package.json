{
  "name": "@narrative/render-worker",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env ../../node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@narrative/shared": "workspace:*",
    "bullmq": "^6.3.14",
    "ioredis": "^6.0.0",
    "playwright-core": "1.64.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
