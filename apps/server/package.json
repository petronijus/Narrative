{
  "name": "@narrative/server",
  "version": "0.12.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --max-old-space-size=8192 ../../node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "test:integration": "node --env-file=../../.env ../../node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "db:generate": "echo 'Refusing: migrations here are hand-written. drizzle-kit generate emits a destructive full-schema migration (snapshots are intentionally not maintained). See apps/server/drizzle/README.md' >&2 && exit 1",
    "db:migrate": "node --env-file=../../.env ../../node_modules/tsx/dist/cli.mjs src/db/migrate.ts",
    "db:migrate-demo": "node --env-file=../../.env ../../node_modules/tsx/dist/cli.mjs src/scripts/migrateDemoUserDecks.ts",
    "db:backfill-video": "node --env-file=../../.env ../../node_modules/tsx/dist/cli.mjs src/scripts/backfillVideoPlayback.ts",
    "db:purge-components": "node --env-file=../../.env ../../node_modules/tsx/dist/cli.mjs src/scripts/purgeComponentInstances.ts",
    "db:revoke-user": "node --env-file=../../.env ../../node_modules/tsx/dist/cli.mjs src/scripts/revokeUserAccess.ts",
    "start": "node --max-old-space-size=8192 dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^10.1.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/rate-limit": "^11.2.1",
    "@hocuspocus/extension-database": "^2.15.3",
    "@hocuspocus/server": "^2.15.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@narrative/commands": "workspace:*",
    "@narrative/shared": "workspace:*",
    "@narrative/slide-model": "workspace:*",
    "@nodable/entities": "^2.2.0",
    "@sentry/node": "^8.55.2",
    "@tus/s3-store": "^1.9.1",
    "@tus/server": "^1.10.2",
    "bullmq": "^5.81.5",
    "dompurify": "^3.4.17",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.7",
    "ioredis": "^5.11.1",
    "jose": "^6.2.12",
    "jsdom": "^26.1.0",
    "jszip": "^3.10.2",
    "lib0": "^0.2.119",
    "nanoid": "^5.1.16",
    "opentype.js": "1.3.4",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "probe-image-size": "^7.4.0",
    "resend": "^6.33.0",
    "sharp": "^0.35.5",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hocuspocus/provider": "^2.15.3",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.19.2",
    "@types/opentype.js": "^1.3.10",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "playwright": "1.64.1",
    "vitest": "^4.1.11",
    "y-protocols": "^1.0.7"
  }
}
