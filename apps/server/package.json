{
  "name": "@narrative/server",
  "version": "0.7.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env ../../node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node ../../node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=../../.env ../../node_modules/tsx/dist/cli.mjs src/db/migrate.ts",
    "db:migrate-demo": "node --env-file=../../.env ../../node_modules/tsx/dist/cli.mjs src/scripts/migrateDemoUserDecks.ts",
    "db:purge-components": "node --env-file=../../.env ../../node_modules/tsx/dist/cli.mjs src/scripts/purgeComponentInstances.ts",
    "pptx:spike": "node --expose-gc ../../node_modules/tsx/dist/cli.mjs src/scripts/pptxSpike.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.776.0",
    "@aws-sdk/s3-request-presigner": "^3.1040.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/formbody": "^8.0.2",
    "@hocuspocus/extension-database": "^2.15.0",
    "@hocuspocus/server": "^2.15.0",
    "@narrative/shared": "workspace:*",
    "@narrative/slide-model": "workspace:*",
    "@sentry/node": "^8.51.0",
    "@tus/s3-store": "^1.5.0",
    "@tus/server": "^1.8.0",
    "bullmq": "^5.52.0",
    "drizzle-orm": "^0.43.1",
    "fast-xml-parser": "^5.8.0",
    "fastify": "^5.3.2",
    "ioredis": "^5.6.1",
    "jose": "^6.2.2",
    "jszip": "^3.10.1",
    "nanoid": "^5.0.9",
    "opentype.js": "^1.3.4",
    "pg": "^8.14.1",
    "pino": "^9.6.0",
    "pptxgenjs": "^4.0.1",
    "probe-image-size": "^7.2.3",
    "resend": "^6.12.3",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.14.1",
    "@types/opentype.js": "^1.3.9",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.31.1",
    "pino-pretty": "^13.0.0",
    "vitest": "^3.1.2"
  }
}
