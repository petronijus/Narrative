{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2025",
    "lib": ["ES2025", "ESNext.Disposable"],
    "outDir": "dist",
    "rootDir": "../..",
    "paths": {
      "@narrative/shared": ["../../packages/shared/src/index.ts"],
      "@narrative/slide-model": ["../../packages/slide-model/src/index.ts"],
      "@narrative/commands": ["../../packages/commands/src/index.ts"],
      "@narrative/commands/playbooks": ["../../packages/commands/src/playbooks/index.ts"],
      "@narrative/perf/stats": ["../../packages/perf/src/stats.ts"]
