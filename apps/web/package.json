{
  "name": "@narrative/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node ../../node_modules/vitest/vitest.mjs run",
    "preview": "vite preview",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "main app chunk (volatile, busts on every deploy)",
      "path": "dist/assets/index-*.js",
      "limit": "210 KB",
      "gzip": true
    },
    {
      "name": "Pixi vendor chunk (cached across deploys)",
      "path": "dist/assets/vendor-pixi-*.js",
      "limit": "180 KB",
      "gzip": true
    },
    {
      "name": "React + router vendor chunk",
      "path": "dist/assets/vendor-react-*.js",
      "limit": "130 KB",
      "gzip": true
    },
    {
      "name": "Tiptap + ProseMirror vendor chunk",
      "path": "dist/assets/vendor-tiptap-*.js",
      "limit": "120 KB",
      "gzip": true
    },
    {
      "name": "Yjs + Hocuspocus + y-prosemirror vendor chunk",
      "path": "dist/assets/vendor-yjs-*.js",
      "limit": "45 KB",
      "gzip": true
    },
    {
      "name": "GSAP vendor chunk",
      "path": "dist/assets/vendor-gsap-*.js",
      "limit": "32 KB",
      "gzip": true
    },
    {
      "name": "hls.js vendor chunk (lazy-loaded if you reintroduce dynamic import)",
      "path": "dist/assets/vendor-hls-*.js",
      "limit": "170 KB",
      "gzip": true
    },
    {
      "name": "Total first-paint payload (excludes vendor-hls — only loads when a video plays)",
      "path": [
        "dist/assets/index-*.js",
        "dist/assets/vendor-pixi-*.js",
        "dist/assets/vendor-react-*.js",
        "dist/assets/vendor-tiptap-*.js",
        "dist/assets/vendor-yjs-*.js",
        "dist/assets/vendor-gsap-*.js",
        "dist/assets/vendor-radix-*.js",
        "dist/assets/vendor-*.js",
        "!dist/assets/vendor-hls-*.js",
        "!dist/assets/vendor-sentry-*.js"
      ],
      "limit": "800 KB",
      "gzip": true
    }
  ],
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@hocuspocus/provider": "^2.15.0",
    "@narrative/animation": "workspace:*",
    "@narrative/shared": "workspace:*",
    "@narrative/slide-model": "workspace:*",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/react": "^8.51.0",
    "@tiptap/extension-collaboration": "^3.22.4",
    "@tiptap/pm": "^3.22.4",
    "@tiptap/react": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hls.js": "^1.5.0",
    "idb": "^8.0.0",
    "lucide-react": "^1.8.0",
    "nanoid": "^5.0.7",
    "oidc-client-ts": "^3.1.0",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.9.2",
    "react": "^18.3.1",
    "react-colorful": "^5.6.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.5.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "tus-js-client": "^4.3.1",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@size-limit/file": "^11.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "jsdom": "^26.1.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.3",
    "size-limit": "^11.0.0",
    "tailwindcss": "^3.4.17",
    "vite": "^6.3.3",
    "vitest": "^3.1.2"
  }
}
