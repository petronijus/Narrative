{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "paths": {
      "@narrative/animation": ["../../packages/animation/src/index.ts"],
      "@narrative/commands": ["../../packages/commands/src/index.ts"],
      "@narrative/shared": ["../../packages/shared/src/index.ts"],
      "@narrative/slide-model": ["../../packages/slide-model/src/index.ts"],
      "@/*": ["./src/*"]
    },
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
