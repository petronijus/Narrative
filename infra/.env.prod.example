# Narrative — production env vars template
# Copy to infra/.env.prod and fill in values.
# NEVER commit .env.prod to git.

# ─── Domain ────────────────────────────────────────────────────────────────────
# Public hostname configured in the Cloudflare Tunnel "Public Hostname" page.
# Cloudflare manages DNS + TLS — no router port-forward, no Let's Encrypt.
# Caddy uses this value to match the Host header from cloudflared.
DOMAIN=narrative.example.com

# ─── Cloudflare Tunnel ─────────────────────────────────────────────────────────
# Create the tunnel at https://one.dash.cloudflare.com → Networks → Tunnels.
# Copy the "Install token" — long string starting with `eyJ...`.
# Public Hostname inside the dashboard:
#   service = http://caddy:80, hostname = narrative.YOURDOMAIN
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME_PASTE_TUNNEL_TOKEN_HERE
# Pin the cloudflared image tag — never use :latest. See
# https://hub.docker.com/r/cloudflare/cloudflared/tags for current versions.
CLOUDFLARED_VERSION=2024.10.1

# ─── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_DB=narrative
POSTGRES_USER=narrative
POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD_MIN_32_CHARS

# Postgres storage. Two options:
#   (default) Leave PG_DATA_PATH UNSET → uses a local Docker named volume on the
#             VM disk. Recommended: small DB (single-digit GB even at scale),
#             low-latency fsync, no NFS locking quirks. Durability comes from
#             nightly pg_dump (see BACKUP_DIR below).
#   (override) Set to a host path if you really want the DB on NFS/ZFS. Be aware
#              of the latency + locking caveats — see Postgres docs on NFS.
# PG_DATA_PATH=/mnt/data/narrative/postgres

# ─── Server ────────────────────────────────────────────────────────────────────
API_PORT=3001
HOCUSPOCUS_PORT=3002
LOG_LEVEL=info

# ─── ZFS snapshot (optional, host-side) ────────────────────────────────────────
# Only set this if `zfs` is available on the deploy host. With NFS-backed
# storage (e.g. TrueNAS), leave this empty and snapshot on the NAS instead.
# ZFS_DATASET=

# ─── Backups ───────────────────────────────────────────────────────────────────
# Directory for pg_dump files (backup.sh)
BACKUP_DIR=/mnt/data/narrative/backups
# Number of days to retain backups
RETAIN_DAYS=7

# ─── OIDC (Google) — server-driven session cookie flow ───────────────────────
# Since 2026-05 the server runs the OAuth dance and mints an opaque
# `narrative_session` HttpOnly cookie. The SPA never sees the id_token, so
# `VITE_OIDC_*` values are no longer needed.
#
# Create OAuth 2.0 credentials at:
#   https://console.cloud.google.com → APIs & Services → Credentials → Web app
# Authorized redirect URIs (note the /api/ prefix — Caddy strips it):
#   https://narrative.example.com/api/auth/callback   (prod)
#   http://localhost:3001/auth/callback               (dev)

OIDC_ISSUER=https://accounts.google.com
OIDC_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
OIDC_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
OIDC_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET

# Allowlist — set at least one. Without it, ANY Google account can sign in.
# OIDC_ALLOWED_EMAILS=you@example.com,colleague@example.com
OIDC_ALLOWED_DOMAIN=example.com

# Signs the short-lived PKCE state cookie. REQUIRED in prod.
# Generate: openssl rand -hex 32
SESSION_COOKIE_SECRET=CHANGE_ME_64_HEX_CHARS

# ─── Observability ─────────────────────────────────────────────────────────────
# SENTRY_DSN=                    # M6 — error tracking
# VITE_SENTRY_DSN=

# ─── MinIO object storage (M11) ──────────────────────────────────────────────
MINIO_ROOT_USER=CHANGE_ME_MINIO_ADMIN_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD_MIN_8_CHARS

# Bind-mount path for MinIO object data (host directory).
MINIO_DATA_PATH=/mnt/data/narrative/minio

MEDIA_BUCKET=narrative-media

# ─── imgproxy (M11) ──────────────────────────────────────────────────────────
# Generate with: xxd -g 2 -l 32 -p /dev/random | tr -d '\n'
# Both must be 64 hex characters (32 bytes). NEVER commit these values.
IMGPROXY_KEY=CHANGE_ME_64_HEX_CHARS
IMGPROXY_SALT=CHANGE_ME_64_HEX_CHARS

# ─── Server: how to reach MinIO + imgproxy (from apps/server inside Docker) ──
# In prod, both services are on the internal Docker network.
MINIO_ENDPOINT=http://minio:9000
IMGPROXY_ENDPOINT=http://imgproxy:8080

# ─── Web (apps/web) ──────────────────────────────────────────────────────────
# Public imgproxy URL — browser traffic goes through Caddy (/imgproxy/* route).
# Replace with your actual domain.
VITE_IMGPROXY_URL=https://narrative.example.com/imgproxy

# ─── Video pipeline (M12) ────────────────────────────────────────────────────
# Media queue Redis. Same logic as Postgres — leave UNSET to use a local Docker
# named volume. Queue contents are recoverable (re-enqueue on worker restart),
# so this is even less storage-critical than Postgres.
# MEDIA_REDIS_DATA_PATH=/mnt/data/narrative/media-redis

# Server-side Redis URL (apps/server enqueues BullMQ jobs via this).
# In prod the server container talks to media-redis on the Docker internal network.
MEDIA_REDIS_URL=redis://media-redis:6379

# Parallel ffmpeg transcodes per worker container. Tune after profiling (M29).
WORKER_CONCURRENCY=2

# ─── Future milestones ─────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=             # M16 — AI slide generation
