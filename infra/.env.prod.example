# Narrative — produkční env vars template
# Zkopírujte do infra/.env.prod a vyplňte hodnoty.
# NIKDY necommitujte .env.prod do gitu.

# ─── Doména ────────────────────────────────────────────────────────────────────
# Caddy použije tuto doménu pro auto-TLS (Let's Encrypt)
DOMAIN=narrative.example.com

# ─── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_DB=narrative
POSTGRES_USER=narrative
POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD_MIN_32_CHARS

# ZFS dataset mount point pro Postgres data
# Příklad Proxmox ZFS: /mnt/tank/narrative/postgres
# Pokud nepoužíváte ZFS, nastavte na absolutní cestu pro bind mount
PG_DATA_PATH=/mnt/tank/narrative/postgres

# ─── Server ────────────────────────────────────────────────────────────────────
API_PORT=3001
HOCUSPOCUS_PORT=3002
LOG_LEVEL=info

# ─── ZFS snapshot (volitelné) ──────────────────────────────────────────────────
# Název ZFS datasetu pro snapshot před deployem (deploy.sh)
# Příklad: tank/narrative
ZFS_DATASET=tank/narrative

# ─── Zálohy ────────────────────────────────────────────────────────────────────
# Adresář pro pg_dump soubory (backup.sh)
BACKUP_DIR=/mnt/tank/narrative/backups
# Kolik dní uchovávat zálohy
RETAIN_DAYS=7

# ─── Budoucí milestony ─────────────────────────────────────────────────────────
# AUTHENTIK_SECRET_KEY=          # M10 — OIDC auth
# MINIO_ROOT_USER=               # M11 — object storage
# MINIO_ROOT_PASSWORD=           # M11
# SENTRY_DSN=                    # M6 — error tracking
# ANTHROPIC_API_KEY=             # M16 — AI slide generation
