# Narrative — production env vars template
# Copy to infra/.env.prod and fill in values.
# NEVER commit .env.prod to git.

# ─── Domain ────────────────────────────────────────────────────────────────────
# Public hostname configured in the Cloudflare Tunnel "Public Hostname" page.
# Cloudflare manages DNS + TLS — no router port-forward, no Let's Encrypt.
# Caddy uses this value to match the Host header from cloudflared.
DOMAIN=narrative.example.com

# ─── Cloudflare Tunnel ─────────────────────────────────────────────────────────
# Create the tunnel at https://one.dash.cloudflare.com → Networks → Tunnels.
# Copy the "Install token" — long string starting with `eyJ...`.
# Public Hostname inside the dashboard:
#   service = http://caddy:80, hostname = narrative.YOURDOMAIN
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME_PASTE_TUNNEL_TOKEN_HERE
# Pin the cloudflared image tag — never use :latest. See
# https://hub.docker.com/r/cloudflare/cloudflared/tags for current versions.
CLOUDFLARED_VERSION=2024.10.1

# ─── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_DB=narrative
POSTGRES_USER=narrative
POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD_MIN_32_CHARS

# Postgres storage. Two options:
#   (default) Leave PG_DATA_PATH UNSET → uses a local Docker named volume on the
#             VM disk. Recommended: small DB (single-digit GB even at scale),
#             low-latency fsync, no NFS locking quirks. Durability comes from
#             nightly pg_dump (see BACKUP_DIR below).
#   (override) Set to a host path if you really want the DB on NFS/ZFS. Be aware
#              of the latency + locking caveats — see Postgres docs on NFS.
# PG_DATA_PATH=/mnt/data/narrative/postgres

# ─── Server ────────────────────────────────────────────────────────────────────
API_PORT=3001
HOCUSPOCUS_PORT=3002
LOG_LEVEL=info

# ─── ZFS snapshot (optional, host-side) ────────────────────────────────────────
# Only set this if `zfs` is available on the deploy host. With NFS-backed
# storage (e.g. TrueNAS), leave this empty and snapshot on the NAS instead.
# ZFS_DATASET=

# ─── Backups ───────────────────────────────────────────────────────────────────
# Directory for pg_dump files (backup.sh)
BACKUP_DIR=/mnt/data/narrative/backups
# Number of days to retain backups
RETAIN_DAYS=7

# ─── OIDC (Google) — server-driven session cookie flow ───────────────────────
# Since 2026-05 the server runs the OAuth dance and mints an opaque
# `narrative_session` HttpOnly cookie. The SPA never sees the id_token, so
# `VITE_OIDC_*` values are no longer needed.
#
# Create OAuth 2.0 credentials at:
#   https://console.cloud.google.com → APIs & Services → Credentials → Web app
# Authorized redirect URIs (note the /api/ prefix — Caddy strips it):
#   https://narrative.example.com/api/auth/callback   (prod)
#   http://localhost:3001/auth/callback               (dev)

OIDC_ISSUER=https://accounts.google.com
OIDC_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
OIDC_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
OIDC_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET

# Allowlist — set at least one. Without it, ANY Google account can sign in.
# OIDC_ALLOWED_EMAILS=you@example.com,colleague@example.com
OIDC_ALLOWED_DOMAIN=example.com

# Instance admins (docs/adr/0014): own every folder and deck except other people's
# Drafts and decide who may sign in, in the admin screen. Verified emails.
# ADMIN_EMAILS=you@example.com

# Signs the short-lived PKCE state cookie. REQUIRED in prod.
# Generate: openssl rand -hex 32
SESSION_COOKIE_SECRET=CHANGE_ME_64_HEX_CHARS

# ─── MCP server + OAuth for agents (docs/mcp.md) ──────────────────────────────
# Public base URL of the API; the MCP endpoint users paste into claude.ai /
# Claude Code is <base>/mcp and every MCP OAuth token is bound to it. The
# compose default (docker-compose.prod.yml) is https://${DOMAIN}/api — set it
# only if the API is served somewhere else.
# PUBLIC_API_URL=https://narrative.example.com/api
# Extra OAuth redirect URIs besides the built-in claude.ai callback and Claude
# Code's loopback callbacks: comma-separated https URLs (exact), or http URLs on
# localhost / 127.0.0.1 (any port) for other local MCP clients. Usually empty.
# MCP_OAUTH_REDIRECT_URIS=
# Hosts whose OAuth Client ID Metadata Documents are accepted (comma-separated,
# `none` = none). Compose default: claude.ai (serves Claude Code's document).
# MCP_OAUTH_CIMD_HOSTS=claude.ai
# OAuth dynamic client registration (RFC 7591). Compose default false — Claude
# Code and claude.ai use metadata documents; enable only for other clients.
# MCP_OAUTH_DCR_ENABLED=false
# Hostnames agent URL downloads (media/font upload, PowerPoint import by URL)
# may reach WITHOUT the user confirming the host: comma-separated, exact, no
# port. Empty (default): every URL download is confirmed by the user.
# AGENT_URL_FETCH_ALLOWED_HOSTS=
# HMAC key of the opaque "working for" key agent peers carry in awareness.
# REQUIRED (>= 32 chars); the server refuses to start without it. Rotating it
# needs no migration. Generate: openssl rand -base64 48
AGENT_PRINCIPAL_KEY_SECRET=
# OAuth discovery also needs Caddy's root route for /.well-known/oauth-* — it
# is in infra/caddy/Caddyfile, nothing to set here.
# Client IP (rate limits, WebSocket failed-auth throttle): the server reads
# CLIENT_IP_HEADER=cf-connecting-ip (set in docker-compose.prod.yml), and Caddy
# overwrites that header unless the TCP peer is the cloudflared connector.
# Shared-tunnel topology: SET THIS to the real LAN address of the host running
# cloudflared. The overlay default (192.0.2.101/32) is a documentation-range
# placeholder and never matches a real peer; without the real value every
# visitor shares one rate-limit bucket. Bundled cloudflared: leave unset
# (private_ranges). docs/deploy.md "Client IP".
# CLOUDFLARED_TRUSTED_PROXIES=<cloudflared-host-lan-ip>/32

# ─── Transactional email (Resend) — deck invites ──────────────────────────────
# Without a key, the server logs the would-be email but still writes the
# `deck_invites` row. Set both env vars below before launch.
#   - Get API key: https://resend.com → API Keys
#   - Verify your domain in the Resend dashboard, then add the SPF + DKIM
#     TXT records they generate to your DNS (Cloudflare). After
#     verification you can send FROM @yourdomain.
RESEND_API_KEY=CHANGE_ME_RESEND_API_KEY
# Quote the value — the `<…>` angle brackets are bash redirection
# operators when the deploy script `source`s this file.
EMAIL_FROM="Narrative <noreply@yourdomain.com>"

# ─── Observability ─────────────────────────────────────────────────────────────
# SENTRY_DSN=                    # M6 — error tracking
# VITE_SENTRY_DSN=

# ─── MinIO object storage (M11) ──────────────────────────────────────────────
MINIO_ROOT_USER=CHANGE_ME_MINIO_ADMIN_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD_MIN_8_CHARS

# Bind-mount path for MinIO object data (host directory).
MINIO_DATA_PATH=/mnt/data/narrative/minio

MEDIA_BUCKET=narrative-media

# ─── imgproxy (M11) ──────────────────────────────────────────────────────────
# Generate with: xxd -g 2 -l 32 -p /dev/random | tr -d '\n'
# Both must be 64 hex characters (32 bytes). NEVER commit these values.
IMGPROXY_KEY=CHANGE_ME_64_HEX_CHARS
IMGPROXY_SALT=CHANGE_ME_64_HEX_CHARS

# ─── Server: how to reach MinIO + imgproxy (from apps/server inside Docker) ──
# In prod, both services are on the internal Docker network.
MINIO_ENDPOINT=http://minio:9000
IMGPROXY_ENDPOINT=http://imgproxy:8080
# MEDIA-1: browser-facing base for presigned media URLs (private bucket).
# MUST be the public host Caddy serves at /storage/* — NOT the internal
# MINIO_ENDPOINT above — or the SigV4 signature won't validate. Defaults to
# https://${DOMAIN}/storage in compose; override here only if your /storage
# route lives elsewhere. Optional TTL overrides (seconds):
#   MEDIA_VIDEO_URL_TTL_SEC (default 21600 = 6h), MEDIA_FONT_URL_TTL_SEC (3600 = 1h)
MINIO_PUBLIC_URL=https://narrative.example.com/storage

# ─── Video pipeline (M12) ────────────────────────────────────────────────────
# Media queue Redis. Same logic as Postgres — leave UNSET to use a local Docker
# named volume. Queue contents are recoverable (re-enqueue on worker restart),
# so this is even less storage-critical than Postgres.
# MEDIA_REDIS_DATA_PATH=/mnt/data/narrative/media-redis

# Server-side Redis URL (apps/server enqueues BullMQ jobs via this).
# In prod the server container talks to media-redis on the Docker internal network.
MEDIA_REDIS_URL=redis://media-redis:6379

# Parallel ffmpeg transcodes per worker container. Tune after profiling (M29).
WORKER_CONCURRENCY=2

# ─── Deployment topology ───────────────────────────────────────────────────────
# Set to 1 when an EXTERNAL cloudflared (running elsewhere on the LAN) handles
# ingress and Caddy must publish host port 80. This makes deploy.sh add
# docker-compose.prod.shared-tunnel.yml, which `!reset`-clears the 127.0.0.1
# host-port bindings on every internal service (postgres/minio/redis/imgproxy/
# imgproxy-cache/server). REQUIRED in that topology: without it, deploy.sh keeps
# those host ports and `docker compose up -d` hits the Docker 29.4 stale-port
# bind bug ("address already in use" though the port is free), breaking redeploys.
# Leave unset/0 only if you run the bundled cloudflared (internal-tunnel profile).
USE_SHARED_TUNNEL=1

# ─── Future milestones ─────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=             # M16 — AI slide generation
