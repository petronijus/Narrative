# Narrative — production env vars template
# Copy to infra/.env.prod and fill in values.
# NEVER commit .env.prod to git.

# ─── Domain ────────────────────────────────────────────────────────────────────
# Caddy uses this domain for auto-TLS (Let's Encrypt).
# Both DOMAIN and auth.DOMAIN must resolve to this server (wildcard DNS or explicit A records).
DOMAIN=narrative.example.com

# ─── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_DB=narrative
POSTGRES_USER=narrative
POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD_MIN_32_CHARS

# ZFS dataset mount point for Postgres data
# Example (Proxmox ZFS): /mnt/tank/narrative/postgres
# If not using ZFS, set to absolute path for bind mount
PG_DATA_PATH=/mnt/tank/narrative/postgres

# ─── Server ────────────────────────────────────────────────────────────────────
API_PORT=3001
HOCUSPOCUS_PORT=3002
LOG_LEVEL=info

# ─── ZFS snapshot (optional) ───────────────────────────────────────────────────
# ZFS dataset name for pre-deploy snapshot (deploy.sh)
# Example: tank/narrative
ZFS_DATASET=tank/narrative

# ─── Backups ───────────────────────────────────────────────────────────────────
# Directory for pg_dump files (backup.sh)
BACKUP_DIR=/mnt/tank/narrative/backups
# Number of days to retain backups
RETAIN_DAYS=7

# ─── Authentik OIDC (M10) ─────────────────────────────────────────────────────
# Generate AUTHENTIK_SECRET_KEY with: openssl rand -hex 32
AUTHENTIK_POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD_MIN_32_CHARS
AUTHENTIK_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
AUTHENTIK_BOOTSTRAP_EMAIL=admin@narrative.example.com
AUTHENTIK_BOOTSTRAP_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
AUTHENTIK_HTTP_PORT=9000

# ZFS dataset path for Authentik persistent data (media, certs, postgres data)
# Subdirectories will be created: $AUTHENTIK_DATA_PATH/postgres, /media, /certs
AUTHENTIK_DATA_PATH=/mnt/tank/narrative/authentik

# Server: OIDC validation config (used by apps/server JWT middleware in M10 phase 2)
# Note: these reference the internal Docker network hostname, not the public subdomain.
# The server container talks directly to authentik-server:9000 for JWKS fetching.
AUTHENTIK_ISSUER=https://auth.narrative.example.com/application/o/narrative/
AUTHENTIK_JWKS_URL=http://authentik-server:9000/application/o/narrative/jwks/
AUTHENTIK_CLIENT_ID=narrative-web

# Web: OIDC client config (VITE_ prefix — these are public values, safe to bundle)
VITE_AUTHENTIK_ISSUER=https://auth.narrative.example.com/application/o/narrative/
VITE_AUTHENTIK_CLIENT_ID=narrative-web
VITE_AUTHENTIK_REDIRECT_URI=https://narrative.example.com/auth/callback

# ─── Observability ─────────────────────────────────────────────────────────────
# SENTRY_DSN=                    # M6 — error tracking
# VITE_SENTRY_DSN=

# ─── Future milestones ─────────────────────────────────────────────────────────
# MINIO_ROOT_USER=               # M11 — object storage
# MINIO_ROOT_PASSWORD=           # M11
# ANTHROPIC_API_KEY=             # M16 — AI slide generation
