# Narrative — Caddyfile
#
# TLS:
#   In prod, Cloudflare Tunnel (cloudflared) terminates HTTPS at the edge and
#   tunnels plain HTTP back to caddy:80. So Caddy never speaks TLS — every site
#   block is prefixed with `http://` to disable Caddy's automatic HTTPS.
#   No port 80 / 443 binding on the host, no Let's Encrypt, no DNS challenge.
#
# Routing:
#   {$DOMAIN}              → React SPA (static files)
#   {$DOMAIN}/api/*        → Fastify HTTP API (port 3001)
#   {$DOMAIN}/ws*          → Hocuspocus WebSocket (port 3002)
#   {$DOMAIN}/storage/*    → MinIO S3 API (port 9000) for presigned URL fetches [M11]
#   {$DOMAIN}/imgproxy/*   → imgproxy image transforms (port 8080) [M11]
#   minio.{$DOMAIN}        → MinIO web console (port 9001) [M11]
#
# Identity: Google OIDC is used directly (no self-hosted IdP), so no auth.DOMAIN.
#
# DNS: managed by Cloudflare automatically when you create the tunnel route in
# the Cloudflare Zero Trust dashboard (Networks → Tunnels → Public Hostname).

# Global option: disable automatic HTTPS — Cloudflare handles TLS.
{
  auto_https off
}

http://{$DOMAIN:localhost} {

  # ── Security headers (site-wide baseline) ──────────────────────────────────
  # nosniff / X-Frame-Options / Referrer-Policy are safe on every response
  # (HTML, JSON, images, objects). The SPA Content-Security-Policy is set
  # separately on the SPA `handle {}` block below — NOT here — so it can never
  # override the stricter `Content-Security-Policy sandbox` that the /storage/*
  # block puts on user-uploaded objects (CSP only meaningfully governs document
  # contexts, and the SPA HTML is the only document this origin serves).
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy strict-origin-when-cross-origin
  }

  # ── REST API ────────────────────────────────────────────────────────────────
  handle_path /api/* {
    reverse_proxy server:3001 {
      # Forward original host (for CORS matching)
      header_up Host {upstream_hostport}

      # `handle_path` strips the /api prefix and the Host override above hides
      # the public hostname, so the upstream cannot reconstruct a browser-facing
      # URL on its own. tus needs one for the `Location` header it answers the
      # upload-creation POST with — without these it hands the browser
      # `http://server:3001/api/uploads/<id>`, which resolves nowhere outside
      # the Docker network. The server reads them via `respectForwardedHeaders`
      # + `X-Forwarded-Prefix` (see apps/server/src/media/tus.ts).
      header_up X-Forwarded-Host {http.request.host}
      header_up X-Forwarded-Prefix /api
    }
  }

  # ── WebSocket (Hocuspocus) ──────────────────────────────────────────────────
  # Client connects via wss://DOMAIN/ws. `handle_path` strips the /ws prefix
  # so the upstream sees `/` (Hocuspocus does the WebSocket upgrade dance at
  # root; anything else falls through to its default HTTP handler which
  # returns 200 "OK" without upgrading).
  # Caddy v2's reverse_proxy auto-detects Upgrade: websocket and switches to
  # bidirectional bytestream mode — no header_up overrides needed (those
  # were in fact preventing the upgrade from being recognised).
  handle_path /ws* {
    reverse_proxy server:3002
  }

  # ── MinIO S3 API passthrough (M11) ─────────────────────────────────────────
  # Used for presigned URL fetches and any direct S3 operations from clients.
  # tus-node-server in apps/server talks to MinIO directly on the internal
  # Docker network (minio:9000) — this route is for external presigned URL access.
  handle_path /storage/* {
    # User-uploaded objects must never render as a same-origin document
    # (SVG/HTML smuggling → script on the app origin). `Content-Disposition:
    # attachment` affects direct navigation only — <img>/<video>/@font-face
    # subresource loads are unaffected. `sandbox` CSP neutralises script even
    # if a response is still rendered inline somewhere.
    header {
      X-Content-Type-Options nosniff
      Content-Security-Policy sandbox
      Content-Disposition attachment
    }
    reverse_proxy minio:9000
  }

  # ── imgproxy image transforms (M11) ────────────────────────────────────────
  # Browser requests signed imgproxy URLs via this route.
  # URL signing is implemented in apps/server (media agent, phase 2).
  # Example: /imgproxy/sig/rs:fit:400:0/plain/s3://narrative-media/decks/x/uploads/y/original.jpg
  #
  # Routed through the nginx disk cache (imgproxy-cache), NOT imgproxy
  # directly: open-source imgproxy has no result cache, so each cold
  # request would re-encode from scratch. AVIF encoding is CPU-heavy —
  # the cache makes each (asset, variant, format) encode exactly once.
  handle_path /imgproxy/* {
    reverse_proxy imgproxy-cache:80
  }

  # ── Health check ────────────────────────────────────────────────────────────
  handle /health {
    reverse_proxy server:3001
  }

  # ── Static SPA (React) ──────────────────────────────────────────────────────
  handle {
    # Content-Security-Policy for the SPA document. The app is entirely
    # same-origin (apps/web CSP audit — see
    # docs/audits/2026-06-12-security-perf-quality-audit.md):
    #   script-src 'self'      — Vite emits only an external module bundle
    #                            (esnext target → no inline polyfill); no
    #                            eval/wasm anywhere.
    #   style-src  'unsafe-inline' — required by React `style={{}}` and Pixi v8
    #                            HTMLText's generated inline <style>/attrs
    #                            (nonces impractical for both).
    #   img-src    data: blob: — base64 slide thumbnails + CSS SVG data-URIs,
    #                            canvas snapshots; plus same-origin imgproxy/storage.
    #   media/font 'self'      — same-origin /storage presigned + bundled /assets.
    #   connect-src 'self'     — /api, same-origin wss /ws, /storage, /imgproxy
    #                            ('self' covers same-origin wss). If
    #                            VITE_SENTRY_DSN is set in prod, append the DSN's
    #                            ingest host (e.g. https://oNNN.ingest.us.sentry.io)
    #                            — Sentry POSTs envelopes directly there, no tunnel.
    #   no workers, iframes, plugins; base-uri/frame-ancestors locked down.
    header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self'; font-src 'self'; connect-src 'self'; worker-src 'none'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; frame-src 'none'"
    root * /srv/web
    # SPA fallback — client-side routes return index.html
    try_files {path} /index.html
    file_server
  }

  # ── Logging ─────────────────────────────────────────────────────────────────
  log {
    output stdout
    format json
    level INFO
  }
}

# ── MinIO web console (M11) ────────────────────────────────────────────────────
# Subdomain: minio.{$DOMAIN} → MinIO console on port 9001.
# Admin access only — protect with firewall.
# In dev (DOMAIN=localhost) this block is unreachable — use localhost:9101 directly.
# DNS: requires minio.{$DOMAIN} A record or wildcard *.{$DOMAIN}.
http://minio.{$DOMAIN:localhost} {
  reverse_proxy minio:9001

  log {
    output stdout
    format json
    level INFO
  }
}
