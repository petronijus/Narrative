# Narrative — Caddyfile
#
# TLS:
#   In prod, Cloudflare Tunnel (cloudflared) terminates HTTPS at the edge and
#   tunnels plain HTTP back to caddy:80. So Caddy never speaks TLS — every site
#   block is prefixed with `http://` to disable Caddy's automatic HTTPS.
#   No port 80 / 443 binding on the host, no Let's Encrypt, no DNS challenge.
#
# Routing:
#   {$DOMAIN}              → React SPA (static files)
#   {$DOMAIN}/api/*        → Fastify HTTP API (port 3001)
#   {$DOMAIN}/.well-known/oauth-authorization-server[/*],
#   {$DOMAIN}/.well-known/oauth-protected-resource[/*]
#                          → Fastify HTTP API, path NOT stripped (OAuth
#                            discovery for MCP connectors, see below)
#   {$DOMAIN}/ws*          → Hocuspocus WebSocket (port 3002)
#   {$DOMAIN}/storage/*    → MinIO S3 API (port 9000) for presigned URL fetches [M11]
#   {$DOMAIN}/imgproxy/*   → imgproxy image transforms (port 8080) [M11]
#   minio.{$DOMAIN}        → MinIO web console (port 9001) [M11]
#
# Identity: Google OIDC is used directly (no self-hosted IdP), so no auth.DOMAIN.
#
# DNS: managed by Cloudflare automatically when you create the tunnel route in
# the Cloudflare Zero Trust dashboard (Networks → Tunnels → Public Hostname).

# Global option: disable automatic HTTPS — Cloudflare handles TLS.
{
  auto_https off
}

http://{$DOMAIN:localhost} {

  # ── Security headers (site-wide baseline) ──────────────────────────────────
  # nosniff / X-Frame-Options / Referrer-Policy are safe on every response
  # (HTML, JSON, images, objects). The SPA Content-Security-Policy is set
  # separately on the SPA `handle {}` block below — NOT here — so it can never
  # override the stricter `Content-Security-Policy sandbox` that the /storage/*
  # block puts on user-uploaded objects (CSP only meaningfully governs document
  # contexts, and the SPA HTML is the only document this origin serves).
  #
  # Referrer-Policy strict-origin: a page opened from a share link (or the
  # render worker's page) has `?share_token=` in its URL, and the default
  # `strict-origin-when-cross-origin` sends that full URL as the Referer of
  # every same-origin request — images, fonts, imgproxy — into the access
  # logs here and in imgproxy-cache. Nothing reads the Referer (the API's
  # same-origin check uses Origin, apps/server/src/http/sameOrigin.ts).
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy strict-origin
  }

  # ── Client IP: never trust a client-supplied CF-Connecting-IP ──────────────
  # The API keys anonymous rate-limit buckets, its per-IP pre-limit and the
  # WebSocket failed-authentication throttle on CF-Connecting-IP
  # (CLIENT_IP_HEADER, apps/server/src/http/clientIp.ts). Cloudflare's edge
  # sets that header on every request that comes through the tunnel, but
  # anything that reaches this port directly — another host on the LAN in the
  # shared-tunnel topology, where :80 is published — could send its own and
  # pick (or poison) any bucket. So unless the TCP peer is the cloudflared
  # connector (CLOUDFLARED_TRUSTED_PROXIES, set per topology in the compose
  # overlays; see docs/deploy.md "Client IP"), the header is overwritten with
  # the peer's real address before any upstream sees it. `remote_ip` matches
  # the immediate peer, never a forwarded address.
  @untrusted_client_ip not remote_ip {$CLOUDFLARED_TRUSTED_PROXIES:private_ranges}
  request_header @untrusted_client_ip CF-Connecting-IP {remote_host}

  # ── REST API ────────────────────────────────────────────────────────────────
  handle_path /api/* {
    reverse_proxy server:3001 {
      # Forward original host (for CORS matching)
      header_up Host {upstream_hostport}

      # `handle_path` above strips the /api prefix, so the upstream sees a path
      # one segment shorter than the one the browser must call back. tus needs
      # the public path for the `Location` header it answers the upload-creation
      # POST with, and reconstructs it from this header
      # (see buildPublicUploadUrl in apps/server/src/media/tus.ts).
      header_up X-Forwarded-Prefix /api
    }
  }

  # ── OAuth discovery at the host root (MCP connectors) ──────────────────────
  # claude.ai and Claude Code discover Narrative's OAuth authorization server
  # from its RFC 8414 metadata. The issuer is https://{$DOMAIN}/api, and a
  # client builds the metadata URL by inserting the well-known name BEFORE the
  # issuer's path, at the host root:
  #   https://{$DOMAIN}/.well-known/oauth-authorization-server/api
  # which is outside /api, so without this route it would hit the SPA
  # fallback and discovery would fail. The RFC 9728 root form of the MCP
  # resource's metadata (/.well-known/oauth-protected-resource/api/mcp) takes
  # the same way; the server answers only the paths that name its issuer and
  # resource (404 otherwise). The path is passed through unchanged (`handle`,
  # not `handle_path`): the API registers these routes at its root
  # (apps/server/src/mcp/oauth/routes.ts, docs/mcp.md).
  # JSON only — the SPA Content-Security-Policy is not involved and stays as
  # it is (ADR 0007).
  @oauth_discovery path /.well-known/oauth-authorization-server /.well-known/oauth-authorization-server/* /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/*
  handle @oauth_discovery {
    reverse_proxy server:3001 {
      header_up Host {upstream_hostport}
    }
  }

  # ── WebSocket (Hocuspocus) ──────────────────────────────────────────────────
  # Client connects via wss://DOMAIN/ws. `handle_path` strips the /ws prefix
  # so the upstream sees `/` (Hocuspocus does the WebSocket upgrade dance at
  # root; anything else falls through to its default HTTP handler which
  # returns 200 "OK" without upgrading).
  # Caddy v2's reverse_proxy auto-detects Upgrade: websocket and switches to
  # bidirectional bytestream mode — no header_up overrides needed (those
  # were in fact preventing the upgrade from being recognised).
  handle_path /ws* {
    reverse_proxy server:3002
  }

  # ── MinIO S3 API passthrough (M11) ─────────────────────────────────────────
  # Used for presigned URL fetches and any direct S3 operations from clients.
  # tus-node-server in apps/server talks to MinIO directly on the internal
  # Docker network (minio:9000) — this route is for external presigned URL access.
  handle_path /storage/* {
    # User-uploaded objects must never render as a same-origin document
    # (SVG/HTML smuggling → script on the app origin). `Content-Disposition:
    # attachment` affects direct navigation only — <img>/<video>/@font-face
    # subresource loads are unaffected. `sandbox` CSP neutralises script even
    # if a response is still rendered inline somewhere.
    header {
      X-Content-Type-Options nosniff
      Content-Security-Policy sandbox
      Content-Disposition attachment
    }
    reverse_proxy minio:9000
  }

  # ── imgproxy image transforms (M11) ────────────────────────────────────────
  # Browser requests signed imgproxy URLs via this route.
  # URL signing is implemented in apps/server (media agent, phase 2).
  # Example: /imgproxy/sig/rs:fit:400:0/plain/s3://narrative-media/decks/x/uploads/y/original.jpg
  #
  # Routed through the nginx disk cache (imgproxy-cache), NOT imgproxy
  # directly: open-source imgproxy has no result cache, so each cold
  # request would re-encode from scratch. AVIF encoding is CPU-heavy —
  # the cache makes each (asset, variant, format) encode exactly once.
  handle_path /imgproxy/* {
    reverse_proxy imgproxy-cache:80
  }

  # ── Health check ────────────────────────────────────────────────────────────
  handle /health {
    reverse_proxy server:3001
  }

  # ── Static SPA (React) ──────────────────────────────────────────────────────
  handle {
    # Content-Security-Policy for the SPA document. The app is entirely
    # same-origin (apps/web CSP audit — see
    # docs/audits/2026-06-12-security-perf-quality-audit.md):
    #   script-src 'self'      — Vite emits only an external module bundle
    #                            (esnext target → no inline polyfill); no
    #                            eval/wasm anywhere.
    #   style-src  'unsafe-inline' — required by React `style={{}}` and Pixi v8
    #                            HTMLText's generated inline <style>/attrs
    #                            (nonces impractical for both).
    #   img-src    data: blob: — base64 slide thumbnails + CSS SVG data-URIs,
    #                            canvas snapshots; plus same-origin imgproxy/storage.
    #   font-src   data:       — Pixi v8 rasterises HTMLText by building an SVG
    #                            whose @font-face embeds the font as a data URL
    #                            (see pixi.js loadFontCSS: `src: url('${dataSrc}')`).
    #                            Without `data:` every canvas text falls back to
    #                            a system face no matter what the deck asks for.
    #                            Plus same-origin /storage presigned folder fonts.
    #   media-src  'self'      — same-origin /storage presigned.
    #   connect-src data:      — Pixi probes ImageBitmap support inside its
    #                            texture worker by fetching a 1×1 data: PNG;
    #                            blocking it makes the probe throw on every
    #                            image load.
    #   connect-src 'self'     — /api, same-origin wss /ws, /storage, /imgproxy
    #                            ('self' covers same-origin wss). If
    #                            VITE_SENTRY_DSN is set in prod, append the DSN's
    #                            ingest host (e.g. https://oNNN.ingest.us.sentry.io)
    #                            — Sentry POSTs envelopes directly there, no tunnel.
    #   worker-src 'self' blob: — Pixi v8 decodes textures in a Worker it
    #                            builds from a blob URL. With worker-src 'none'
    #                            that worker is killed and Assets.load() never
    #                            settles, so images silently never appear on the
    #                            canvas (slide thumbnails, which decode via
    #                            Image.decode(), kept working and masked it).
    #   no iframes or plugins; base-uri/frame-ancestors locked down.
    header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self'; font-src 'self' data:; connect-src 'self' data:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; frame-src 'none'"
    root * /srv/web
    # SPA fallback — client-side routes return index.html
    try_files {path} /index.html

    # index.html names the content-hashed bundles, so a cached copy pins the
    # browser to the previous deploy's JS — a deploy then looks like it did
    # nothing until someone hits Ctrl+Shift+R. Nothing set a Cache-Control on
    # it, which leaves the browser free to cache heuristically off
    # Last-Modified, and that is exactly what happened. Force revalidation on
    # every document (`try_files` serves index.html for /deck/… too, so match
    # on "not an asset" rather than on the /index.html path). The files under
    # /assets/* are content-hashed and keep whatever caching they had.
    @spa_document {
      not path /assets/*
    }
    header @spa_document Cache-Control "no-cache"

    file_server
  }

  # ── Logging ─────────────────────────────────────────────────────────────────
  # JSON access log, with the credentials a URL can carry masked: a share
  # link's id or a render token in `?share_token=` (on the page, on
  # /api/decks/:id and the media reads, on the /ws upgrade — which the API's
  # own redacting serializer never sees, apps/server/src/http/
  # requestLogSerializer.ts), in the URI and in a Referer from an older client.
  log {
    output stdout
    format filter {
      wrap json
      request>uri query {
        replace share_token REDACTED
      }
      request>headers>Referer regexp share_token=[^&#]* share_token=REDACTED
    }
    level INFO
  }
}

# ── MinIO web console (M11) ────────────────────────────────────────────────────
# Subdomain: minio.{$DOMAIN} → MinIO console on port 9001.
# Admin access only — protect with firewall.
# In dev (DOMAIN=localhost) this block is unreachable — use localhost:9101 directly.
# DNS: requires minio.{$DOMAIN} A record or wildcard *.{$DOMAIN}.
http://minio.{$DOMAIN:localhost} {
  reverse_proxy minio:9001

  log {
    output stdout
    format json
    level INFO
  }
}
