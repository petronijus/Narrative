# Non-secret release settings: who builds a release, where it runs, and the
# public domain baked into the web app. Read by infra/scripts/ship.sh (the
# `just deploy` driver), infra/scripts/remote-release.sh (on the builder) and
# infra/scripts/build-push.sh. An environment variable of the same name wins.
# Secrets never live here; production reads its own infra/.env.prod on the VM.

# Public domain: the web app is built against https://$DOMAIN/{api,ws,imgproxy}.
DOMAIN=narrative.bastla.com

# The build host: always on, x86_64 (no emulation), on the LAN with a fast
# uplink, Docker logged in to ghcr.io with a write:packages token. Homelab
# VM 105 on Proxmox, reached over Tailscale from any of Petr's machines.
NARRATIVE_BUILDER=petronijus@100.110.110.101

# The production VM (VM 103) as the builder reaches it, on the LAN.
NARRATIVE_VM=petr@192.168.20.147
