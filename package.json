{
  "name": "narrative",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=12.11.2"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n web,server,worker,render -c blue,green,magenta,cyan \"pnpm --filter web dev\" \"pnpm --filter server dev\" \"pnpm --filter @narrative/video-worker dev\" \"pnpm --filter @narrative/render-worker dev\"",
    "dev:no-worker": "concurrently --kill-others-on-fail -n web,server -c blue,green \"pnpm --filter web dev\" \"pnpm --filter server dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "size": "NARRATIVE_BUILD_MANIFEST=1 pnpm --filter web build && pnpm --filter web size",
    "lighthouse": "pnpm --silent --filter @narrative/perf run perf lighthouse",
    "format": "tools/dev/format.sh --all",
    "capabilities": "pnpm --filter @narrative/commands capabilities",
    "load:all": "node tests/load/runAll.mjs",
    "load:hotedit": "tsx tests/load/hotEdit.ts",
    "load:awareness": "tsx tests/load/awarenessFlood.ts",
    "load:growth": "tsx tests/load/docGrowth.ts",
    "load:deckscale": "tsx tests/load/deckScale.ts",
    "agent:eval": "tsx --tsconfig tests/agent-eval/tsconfig.json tests/agent-eval/run.ts",
    "agent:probe:list-changed": "tsx tests/agent-eval/probes/listChanged.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
