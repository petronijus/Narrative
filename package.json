{
  "name": "narrative",
  "version": "0.16.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "engines": {
    "node": ">=24.15.0",
    "bun": ">=1.4.5"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n web,server,worker,render -c blue,green,magenta,cyan \"bun run --filter web dev\" \"bun run --filter server dev\" \"bun run --filter @narrative/video-worker dev\" \"bun run --filter @narrative/render-worker dev\"",
    "dev:no-worker": "concurrently --kill-others-on-fail -n web,server -c blue,green \"bun run --filter web dev\" \"bun run --filter server dev\"",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun run --filter '*' lint",
    "test": "bun run --filter '*' test",
    "size": "NARRATIVE_BUILD_MANIFEST=1 bun run --filter web build && bun run --filter web size",
    "lighthouse": "bun run --silent --filter @narrative/perf perf lighthouse",
    "format": "tools/dev/format.sh --all",
    "capabilities": "bun run --filter @narrative/commands capabilities",
    "load:all": "node tests/load/runAll.mjs",
    "load:hotedit": "tsx tests/load/hotEdit.ts",
    "load:awareness": "tsx tests/load/awarenessFlood.ts",
    "load:growth": "tsx tests/load/docGrowth.ts",
    "load:deckscale": "tsx tests/load/deckScale.ts",
    "agent:eval": "tsx --tsconfig tests/agent-eval/tsconfig.json tests/agent-eval/run.ts",
    "agent:probe:list-changed": "tsx tests/agent-eval/probes/listChanged.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "undici-types@>=7.28.0": "7.27.2"
  },
  "patchedDependencies": {
    "@stryker-mutator/vitest-runner@10.0.0": "patches/@stryker-mutator__vitest-runner@10.0.0.patch"
  },
  "trustedDependencies": [
    "esbuild",
    "@swc/core",
    "msgpackr-extract"
  ]
}
