{
  "name": "narrative",
  "version": "0.10.11",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n web,server,worker -c blue,green,magenta \"pnpm --filter web dev\" \"pnpm --filter server dev\" \"pnpm --filter @narrative/video-worker dev\"",
    "dev:no-worker": "concurrently --kill-others-on-fail -n web,server -c blue,green \"pnpm --filter web dev\" \"pnpm --filter server dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "size": "pnpm --filter web build && pnpm --filter web size",
    "lighthouse": "pnpm --filter web build && lhci autorun --config=.lighthouserc.json",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,json,md,yaml,yml}\" --ignore-path .gitignore",
    "prepare": "husky",
    "capabilities": "pnpm --filter @narrative/commands capabilities",
    "load:all": "node tests/load/runAll.mjs",
    "load:hotedit": "tsx tests/load/hotEdit.ts",
    "load:awareness": "tsx tests/load/awarenessFlood.ts",
    "load:growth": "tsx tests/load/docGrowth.ts",
    "agent:eval": "tsx tests/agent-eval/run.ts",
    "agent:probe:list-changed": "tsx tests/agent-eval/probes/listChanged.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.14.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "concurrently": "^9.1.2",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "prettier": "^3.5.3",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,cjs,mjs,json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@swc/core",
      "msgpackr-extract"
    ],
    "overrides": {
      "undici-types@>=7.28.0": "7.27.2"
    }
  }
}
