{
  "name": "narrative",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n web,server,worker -c blue,green,magenta \"pnpm --filter web dev\" \"pnpm --filter server dev\" \"pnpm --filter @narrative/video-worker dev\"",
    "dev:no-worker": "concurrently --kill-others-on-fail -n web,server -c blue,green \"pnpm --filter web dev\" \"pnpm --filter server dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "size": "pnpm --filter web build && pnpm --filter web size",
    "lighthouse": "pnpm --filter web build && lhci autorun --config=.lighthouserc.json",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,json,md,yaml,yml}\" --ignore-path .gitignore",
    "prepare": "husky",
    "load:all": "node tests/load/runAll.mjs",
    "load:hotedit": "node --loader ts-node/esm tests/load/hotEdit.ts",
    "load:awareness": "node --loader ts-node/esm tests/load/awarenessFlood.ts",
    "load:growth": "node --loader ts-node/esm tests/load/docGrowth.ts"
  },
  "devDependencies": {
    "@lhci/cli": "^0.14.0",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.25.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,cjs,mjs,json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
