{
  "name": "@narrative/slide-model",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/tsbuildinfo",
    "lint": "eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ src",
    "test": "node ../../node_modules/vitest/vitest.mjs run",
    "mutate": "cd ../.. && stryker run packages/slide-model/stryker.config.json"
  },
  "dependencies": {
    "@narrative/shared": "workspace:*",
    "nanoid": "^6.0.2",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "fast-check": "^4.10.2",
    "vitest": "^5.0.4"
  }
}
